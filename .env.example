# Postgres
POSTGRES_DB=seguimiento
POSTGRES_USER=seguimiento
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar_en_local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200
TIME_ZONE=America/Bogota
MONEDA_BASE=COP

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/auth/google/callback
GOOGLE_DOMINIOS_PERMITIDOS=

# Archivos del expediente
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=25
EXTENSIONES_PERMITIDAS=pdf,docx,xlsx,pptx,png,jpg,jpeg,msg,txt,csv,zip

# Frontend
API_BASE_URL=http://localhost:8000/api/v1

# Integración Jira + Tempo (fase 12; dejar vacío si no se usa)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
TEMPO_API_TOKEN=

# Correo: código de verificación en dos pasos y recuperación de clave
# (fase 13). En dev/test no hace falta llenar esto: el correo se imprime en
# la consola del backend o queda en memoria para los tests.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
FRONTEND_URL=http://localhost:4200
OTP_LIFETIME_MINUTES=10
OTP_MAX_INTENTOS=5
PASSWORD_RESET_TIMEOUT=3600
